<Window x:Class="PhotoBatchStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoBatchStudio.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1500"
        Height="960"
        MinWidth="1240"
        MinHeight="780"
        WindowState="Maximized"
        Background="#F4F1EA">
    <Window.Resources>
        <vm:BooleanToVisibilityExConverter x:Key="BoolToVisibilityEx" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20"
                Margin="0,0,0,16"
                CornerRadius="18"
                Background="#1F3A5F">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding AppTitle}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding AppSubtitle}"
                                   Foreground="#DDE7F3"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Margin="16,0,0,0">
                        <WrapPanel HorizontalAlignment="Right">
                            <Border Padding="10"
                                    Margin="0,0,10,8"
                                    CornerRadius="12"
                                    Background="#315986">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8"
                                               FontSize="11"
                                               Foreground="#DDE7F3"
                                               Text="1. Project" />
                                    <WrapPanel>
                                        <Button Content="{Binding NewProjectText}"
                                                Padding="14,8"
                                                Margin="0,0,8,0"
                                                Command="{Binding NewProjectCommand}" />
                                        <Button Content="{Binding SaveProjectText}"
                                                Padding="14,8"
                                                Margin="0,0,8,0"
                                                Command="{Binding SaveProjectCommand}" />
                                        <Button Content="{Binding LoadProjectText}"
                                                Padding="14,8"
                                                Command="{Binding LoadProjectCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Button Width="42"
                                    Height="40"
                                    Margin="0,0,0,8"
                                    FontSize="18"
                                    Content="&#x2699;"
                                    ToolTip="{Binding SettingsTitleText}"
                                    Command="{Binding ToggleSettingsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="12"
                            CornerRadius="14"
                            Background="#2A4B76">
                        <StackPanel>
                            <TextBlock Text="{Binding XmpPresetText}"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       ToolTip="{Binding XmpPresetTooltip}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Content="{Binding BrowseText}"
                                        ToolTip="{Binding XmpPresetTooltip}"
                                        Command="{Binding BrowsePresetCommand}" />
                                <TextBox Text="{Binding XmpPresetPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding XmpPresetTooltip}"
                                         Background="#F7F4EE" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="12"
                            CornerRadius="14"
                            Background="#2A4B76">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputFolderText}"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       ToolTip="{Binding OutputFolderTooltip}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Content="{Binding BrowseText}"
                                        ToolTip="{Binding OutputFolderTooltip}"
                                        Command="{Binding BrowseOutputCommand}" />
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding OutputFolderTooltip}"
                                         Background="#F7F4EE" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabControl"
                        Grid.Column="0"
                        Margin="0,0,16,16"
                        SelectionChanged="MainTabControl_OnSelectionChanged">
                <TabItem Header="Шаг 1. Обработка пресетом">
                    <Border Padding="14"
                            CornerRadius="16"
                            Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding BatchQueueText}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#2C2C2C" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{Binding AddFilesText}"
                                        Padding="12,6"
                                        Margin="0,0,8,8"
                                        Command="{Binding AddFilesCommand}" />
                                <Button Content="{Binding AddFolderText}"
                                        Padding="12,6"
                                        Margin="0,0,8,8"
                                        Command="{Binding AddFolderCommand}" />
                                <Button Content="{Binding RemoveSelectedText}"
                                        Padding="12,6"
                                        Margin="0,0,8,8"
                                        Command="{Binding RemoveSelectedCommand}" />
                                <Button Content="{Binding ClearListText}"
                                        Padding="12,6"
                                        Margin="0,0,8,8"
                                        Command="{Binding ClearListCommand}" />
                                <Button Content="{Binding StartBatchText}"
                                        Padding="18,8"
                                        Margin="16,0,0,8"
                                        Command="{Binding StartProcessingCommand}" />
                            </WrapPanel>

                            <Border Grid.Row="1"
                                    Margin="0,12,0,12"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="#F7F4EE">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding QueueProgressText}"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C" />
                                    <StackPanel Grid.Row="1"
                                                Margin="0,8,0,0">
                                        <ProgressBar Height="18"
                                                     Minimum="0"
                                                     Maximum="{Binding ProcessingProgressMaximum}"
                                                     Value="{Binding ProcessingProgressValue}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="#6A6A6A"
                                                   Text="{Binding ProcessingProgressText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                      ItemsSource="{Binding Files}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding DataContext.NameColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Width="220"
                                                        Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="{Binding DataContext.FolderColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Width="*"
                                                        Binding="{Binding DirectoryPath}" />
                                    <DataGridTextColumn Header="{Binding DataContext.TypeColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Width="90"
                                                        Binding="{Binding FileType}" />
                                    <DataGridTextColumn Header="{Binding DataContext.StatusColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Width="140"
                                                        Binding="{Binding Status}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="3"
                                       Margin="0,12,0,0"
                                       Text="{Binding Summary}"
                                       Foreground="#6A6A6A" />
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Шаг 2. Отбор и сортировка">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="14"
                                CornerRadius="16"
                                Background="#FCFBF8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Шаг 2. Отбор и сортировка"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C" />

                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right"
                                                Padding="12,6"
                                                Content="{Binding BrowseText}"
                                                Command="{Binding BrowseSortFolderCommand}" />
                                        <TextBox Margin="0,0,8,0"
                                                 Text="{Binding SortFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#8A6A4A"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Text="{Binding SortFolderHintText}" />

                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="0,0,8,8"
                                                   Text="{Binding SortModeText}" />
                                        <ComboBox Width="180"
                                                  Margin="0,0,12,8"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding SortMode, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding SortModes}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="0,0,0,8"
                                                   Text="{Binding ReviewSelectionText}" />
                                    </WrapPanel>
                                </StackPanel>

                                <ListBox x:Name="SortListBox"
                                         Grid.Row="1"
                                         Margin="0,12,0,0"
                                         BorderThickness="0"
                                         SelectionMode="Extended"
                                         SelectionChanged="SortListBox_OnSelectionChanged"
                                         PreviewKeyDown="SortListBox_OnPreviewKeyDown"
                                         ItemsSource="{Binding SortPhotos}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Удалить из списка"
                                                      Command="{Binding DeleteSelectedSortPhotosCommand}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    CornerRadius="12"
                                                    Background="White"
                                                    BorderBrush="#E2DDD5"
                                                    BorderThickness="1">
                                                <DockPanel>
                                                    <Image Width="72"
                                                           Height="72"
                                                           Margin="0,0,10,0"
                                                           Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill" />
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding FileName}" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="#7A7A7A"
                                                                   Text="{Binding DirectoryPath}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="14"
                                CornerRadius="16"
                                Background="#FFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding PreviewText}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#2C2C2C" />

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,12,0,12">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding ZoomText}" />
                                    <Slider Width="220"
                                            Margin="8,0,0,0"
                                            Minimum="0.25"
                                            Maximum="6"
                                            SmallChange="0.05"
                                            LargeChange="0.25"
                                            Value="{Binding PreviewZoom, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Background="#F7F4EE"
                                        CornerRadius="12"
                                        ClipToBounds="True">
                                    <ScrollViewer x:Name="PreviewScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  SizeChanged="PreviewScrollViewer_OnSizeChanged"
                                                  PreviewMouseWheel="PreviewScrollViewer_OnPreviewMouseWheel"
                                                  PreviewMouseLeftButtonDown="PreviewScrollViewer_OnPreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="PreviewScrollViewer_OnPreviewMouseMove"
                                                  PreviewMouseLeftButtonUp="PreviewScrollViewer_OnPreviewMouseLeftButtonUp"
                                                  MouseLeave="PreviewScrollViewer_OnPreviewMouseLeave"
                                                  CanContentScroll="False">
                                        <Grid>
                                            <Image Source="{Binding SelectedPreviewImage}"
                                                   Stretch="Fill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Width="{Binding PreviewDisplayWidth}"
                                                   Height="{Binding PreviewDisplayHeight}"
                                                   Cursor="Hand"
                                                   SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Padding="14"
                                CornerRadius="16"
                                Background="#FFFFFF">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPreviewName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#2C2C2C" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding ReviewSelectionText}"
                                           Foreground="#6A6A6A" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding SortFolderText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EffectiveSortFolder}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#6A6A6A"
                                           Text="Удаление из списка удаляет JPG и из папки Out." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Шаг 3. ИИ постобработка">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.05*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="14"
                                CornerRadius="16"
                                Background="#FCFBF8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding PostprocessPanelText}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C" />

                                    <TextBlock Margin="0,10,0,4"
                                               Text="{Binding PostprocessSourceFolderText}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                Content="{Binding BrowseText}"
                                                ToolTip="{Binding PostprocessSourceFolderTooltip}"
                                                Command="{Binding BrowsePostprocessSourceCommand}" />
                                        <TextBox Text="{Binding PostprocessSourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding PostprocessSourceFolderTooltip}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#6A6A6A"
                                               Text="{Binding EffectivePostprocessSourceFolder}" />

                                    <TextBlock Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#8A6A4A"
                                               Text="{Binding PostprocessPlanHintText}" />

                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding PostprocessSelectedCountText}"
                                               Foreground="#6A6A6A" />
                                </StackPanel>

                                <DataGrid x:Name="PostprocessDataGrid"
                                          Visibility="Collapsed"
                                          Grid.Row="1"
                                          Margin="0,12,0,0"
                                          ItemsSource="{Binding PostprocessFiles}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          SelectionChanged="PostprocessDataGrid_OnSelectionChanged"
                                          PreviewKeyDown="PostprocessDataGrid_OnPreviewKeyDown"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.ScrollUnit="Pixel">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="{Binding DataContext.PostprocessEnabledColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="78" />
                                        <DataGridTextColumn Header="✓"
                                                            Binding="{Binding StatusGlyph}"
                                                            Width="34"
                                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn Header=""
                                                               Width="68"
                                                               IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="48"
                                                            Height="48"
                                                            CornerRadius="8"
                                                            Background="#EFEFEF"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               SnapsToDevicePixels="True"
                                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{Binding DataContext.PostprocessFileColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Binding="{Binding FileName}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="{Binding DataContext.PostprocessStatusColumnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Binding="{Binding Status}"
                                                            Width="120"
                                                            IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ListBox x:Name="PostprocessListBox"
                                         Grid.Row="1"
                                         Margin="0,12,0,0"
                                         ItemsSource="{Binding PostprocessFiles}"
                                         SelectionMode="Extended"
                                         SelectionChanged="PostprocessListBox_OnSelectionChanged"
                                         PreviewKeyDown="PostprocessListBox_OnPreviewKeyDown"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10"
                                                    CornerRadius="12"
                                                    Background="White"
                                                    BorderBrush="#E3DED2"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox VerticalAlignment="Center"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,10,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StatusGlyph}" />
                                                    <Border Grid.Column="2"
                                                            Width="48"
                                                            Height="48"
                                                            CornerRadius="8"
                                                            Background="#EFEFEF"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               SnapsToDevicePixels="True"
                                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="3"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#2C2C2C" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Status}"
                                                                   Foreground="#6A6A6A" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="14"
                                CornerRadius="16"
                                Background="#FFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding PostprocessPreviewText}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C" />
                                    <TextBlock Margin="0,8,0,12"
                                               Text="{Binding SelectedPostprocessPreviewName}"
                                               Foreground="#6A6A6A" />
                                    <TextBlock Text="{Binding SelectedPostprocessModelPathText}"
                                               Foreground="#8A6A4A" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,10,0,8"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="{Binding ZoomText}" />
                                    <Slider Width="220"
                                            Minimum="0.25"
                                            Maximum="4"
                                            Value="{Binding SelectedPostprocessPreviewZoom, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Padding="10"
                                        CornerRadius="12"
                                        Background="#F7F4EE">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Preview"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C2C2C" />
                                        <Border Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Background="White"
                                                CornerRadius="10"
                                                ClipToBounds="True">
                                            <ScrollViewer x:Name="PostprocessBeforeScrollViewer"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          SizeChanged="PostprocessBeforeScrollViewer_OnSizeChanged"
                                                          PreviewMouseWheel="PostprocessPreviewScrollViewer_OnPreviewMouseWheel"
                                                          PreviewMouseLeftButtonDown="PostprocessPreviewScrollViewer_OnPreviewMouseLeftButtonDown"
                                                          PreviewMouseMove="PostprocessPreviewScrollViewer_OnPreviewMouseMove"
                                                          PreviewMouseLeftButtonUp="PostprocessPreviewScrollViewer_OnPreviewMouseLeftButtonUp"
                                                          MouseLeave="PostprocessPreviewScrollViewer_OnPreviewMouseLeave">
                                                <Image Source="{Binding SelectedPostprocessBeforePreviewImage}"
                                                       Width="{Binding SelectedPostprocessBeforePreviewDisplayWidth}"
                                                       Height="{Binding SelectedPostprocessBeforePreviewDisplayHeight}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Padding="14"
                                CornerRadius="16"
                                Background="#FFFFFF">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding PostprocessModelText}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C" />
                                    <TextBlock Margin="0,4,0,8"
                                               TextWrapping="Wrap"
                                               Foreground="#6A6A6A"
                                               Text="Одна выбранная модель применяется ко всем отмеченным файлам." />
                                    <TextBlock Margin="0,0,0,12"
                                               Text="{Binding PostprocessContextText}"
                                               TextWrapping="Wrap"
                                               Foreground="#6A6A6A" />

                                    <ComboBox ItemsSource="{Binding AvailablePostprocessModels}"
                                              SelectedItem="{Binding SelectedPostprocessModel, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              ToolTip="{Binding PostprocessModelDescriptionText}" />

                                    <Button Margin="0,10,0,0"
                                            Padding="14,7"
                                            HorizontalAlignment="Left"
                                            Content="Тест модели"
                                            Click="PostprocessTestButton_Click" />

                                    <TextBlock Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#6A6A6A"
                                               Text="{Binding PostprocessModelDescriptionText}" />

                                    <CheckBox Margin="0,14,0,0"
                                              Content="{Binding PostprocessUseGpuText}"
                                              IsChecked="{Binding UseGpuForModels}" />
                                    <CheckBox Margin="0,8,0,0"
                                              Content="{Binding PostprocessAutoProcessText}"
                                              IsChecked="{Binding AutoProcessPostprocess}" />

                                    <TextBlock Margin="0,14,0,6"
                                               Text="{Binding PostprocessSettings.Count, StringFormat='Model settings: {0}'}"
                                               Foreground="#6A6A6A" />
                                    <ItemsControl ItemsSource="{Binding PostprocessSettings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{Binding Tooltip}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding Tooltip}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#7A7A7A" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Margin="0,6,0,0"
                                            Padding="10"
                                            CornerRadius="12"
                                            Background="#F7F4EE">
                                        <StackPanel>
                                            <ProgressBar Height="18"
                                                         Minimum="0"
                                                         Maximum="{Binding PostprocessProgressMaximum}"
                                                         Value="{Binding PostprocessProgressValue}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{Binding PostprocessProgressText}"
                                                       Foreground="#6A6A6A" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding PostprocessStatusText}"
                                                       Foreground="#2C2C2C" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,14,0,0"
                                                Orientation="Horizontal">
                                        <Button Padding="16,8"
                                                HorizontalAlignment="Left"
                                                Content="{Binding PostprocessProcessText}"
                                                Click="PostprocessProcessButton_Click" />
                                        <Button Margin="10,0,0,0"
                                                Padding="16,8"
                                                HorizontalAlignment="Left"
                                                Content="{Binding PostprocessOverwriteText}"
                                                Click="PostprocessOverwriteButton_Click" />
                                    </StackPanel>

                                    <TextBlock Margin="0,14,0,4"
                                               Text="Лог"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C" />
                                    <TextBox Height="180"
                                             Text="{Binding PostprocessLogText}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             AcceptsReturn="True" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Шаг 4. Постинг">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White">
                        <StackPanel>
                            <TextBlock Text="Шаг 4. Постинг в соцсетях"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#2C2C2C" />
                            <TextBlock Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#6A6A6A"
                                       Text="Заглушка. Здесь позже появятся шаблоны публикации, экспорт под разные соцсети и отправка финальных JPG." />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Column="1"
                    Padding="14"
                    CornerRadius="16"
                    Background="#FCFBF8"
                    Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibilityEx}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding SettingsTitleText}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                       Foreground="#2C2C2C" />
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding CloseSettingsText}"
                                    Padding="10,6"
                                    Command="{Binding ToggleSettingsCommand}" />
                        </DockPanel>

                        <TextBlock Margin="0,16,0,4"
                                   Text="{Binding LanguageText}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="RU"
                                        Padding="12,6"
                                        Margin="0,0,8,0"
                                        Command="{Binding SwitchToRussianCommand}" />
                                <Button Content="EN"
                                        Padding="12,6"
                                        Command="{Binding SwitchToEnglishCommand}" />
                            </StackPanel>

                            <TextBlock Margin="0,16,0,4"
                                       Text="{Binding JpegDescriptionText}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,4"
                                   Text="{Binding ExternalAiCommandText}" />
                        <TextBox Text="{Binding ExternalAiCommand, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding ExternalAiCommandTooltip}" />

                        <TextBlock Margin="0,12,0,4"
                                   Text="{Binding BlurThresholdText}" />
                        <TextBox Text="{Binding BlurThreshold, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,4"
                                   Text="{Binding JpegQualityText}" />
                        <TextBox Text="{Binding JpegQuality, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Margin="0,14,0,0"
                                  Content="{Binding RecursiveText}"
                                  IsChecked="{Binding Recursive}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="{Binding OverwriteXmpText}"
                                  IsChecked="{Binding OverwriteXmp}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="{Binding DetectBlurText}"
                                  IsChecked="{Binding DetectBlur}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="{Binding AutoFixBlurText}"
                                  IsChecked="{Binding AutoFixBlur}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="{Binding RenderRawText}"
                                  IsChecked="{Binding RenderRawWithPhotoshop}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="{Binding UseExternalAiText}"
                                  IsChecked="{Binding UseExternalAi}" />

                        <TextBlock Margin="0,16,0,4"
                                   Text="{Binding CurrentProjectText}" />
                        <TextBlock Text="{Binding CurrentProjectPath}"
                                   TextWrapping="Wrap"
                                   Foreground="#6A6A6A" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="14"
                CornerRadius="16"
                Background="#FFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding ProcessingLogText}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#2C2C2C" />

                <TextBox Grid.Row="1"
                         Margin="0,12,0,0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding LogText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
