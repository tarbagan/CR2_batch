<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PhotoBatchStudio.App</RootNamespace>
    <AssemblyName>PhotoBatchStudio.App</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Title>CR2(RAW) Batch Studio</Title>
    <Product>CR2(RAW) Batch Studio</Product>
    <Company>Tarbagan</Company>
    <Authors>Tarbagan</Authors>
    <Description>Windows batch workflow for CR2/RAW, XMP presets, Adobe Photoshop rendering, review and final selection.</Description>
    <AssemblyName>CR2RawBatchStudio</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\app-icon.ico" />
    <None Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.18.1" />
  </ItemGroup>
</Project>
